{
  "name": "dsh-mengpo",
  "version": "0.2.1",
  "description": "梦婆·记忆（谐音「孟婆汤」）— DSH 本地记忆可视化管理插件：在「插件」页查看/编辑/删除/禁用全局记忆与各项目 insights",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "icon.svg",
    "icon-512.png",
    "locale/*.json",
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.types.json",
    "test": "vitest run",
    "spike": "node scripts/spike.mjs",
    "smoke": "node scripts/smoke.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "memory",
    "mengpo",
    "insights"
  ],
  "author": "LogosFu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LogosFu/dsh-mengpo.git"
  },
  "homepage": "https://github.com/LogosFu/dsh-mengpo#readme",
  "bugs": {
    "url": "https://github.com/LogosFu/dsh-mengpo/issues"
  }
}